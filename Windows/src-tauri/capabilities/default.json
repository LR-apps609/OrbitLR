{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Solo quello che serve alla finestra di OrbitLR",
  "windows": [
    "main",
    "linguetta"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:*"
        },
        {
          "url": "https://github.com/LR-apps609/*"
        },
        {
          "url": "https://www.libreoffice.org/download/*"
        }
      ]
    }
  ]
}