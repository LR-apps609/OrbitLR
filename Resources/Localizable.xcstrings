    "Si allontana piano": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly zooms out"
          }
        }
      }
    },
    "Si apre un’email già pronta: contiene solo quello che scrivi e la versione di OrbitLR, niente nomi di file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ready-made email opens: it contains only what you write and the OrbitLR version, no file names."
          }
