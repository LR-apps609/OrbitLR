    "«%@» ha parti trasparenti: per non perderle resta com'è. Per alleggerirla usa «Ridimensiona» o un peso preciso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has transparent areas: it stays as is so they aren’t lost. To make it smaller, use “Resize” or a specific size"
          }
        }
      }
    },
    "«%@» in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” in %@"
