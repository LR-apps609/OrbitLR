          "stringUnit": {
            "state": "translated",
            "value": "“%@” has no video."
          }
        }
      }
    },
    "«%@» non si apre più.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” won’t open anymore."
          }
        }
      }
    },
    "«%@» non si apre: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” won’t open: %@"
          }
        },
