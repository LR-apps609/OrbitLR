            "value": "«%1$@» non si apre: %2$@"
          }
        }
      }
    },
    "«%@» non si legge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can’t be read"
          }
        }
      }
    },
    "«%@» pesa già meno di %@: non serve comprimerla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already smaller than %@: no need to compress it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» pesa già meno di %2$@: non serve comprimerla"
          }
        }
      }
    },
    "«%@» pesa già meno di %@: non serve comprimerlo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already smaller than %@: no need to compress it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» pesa già meno di %2$@: non serve comprimerlo"
          }
        }
      }
    },
    "«%@» è già compressa al meglio: ricomprimerla la peggiorerebbe senza farla pesare meno": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already optimally compressed: compressing it again would lower the quality without making it smaller"
          }
        }
      }
    },
    "«%@» è già compresso al massimo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already fully compressed"
          }
        }
      }
    },
    "«%@» è già di %lldp o meno: non serve rimpicciolirlo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already %lldp or lower: no need to shrink it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» è già di %2$lldp o meno: non serve rimpicciolirlo"
          }
        }
      }
    },
    "«Rimuovi i metadati» toglie posizione, modello del telefono e data prima di condividere una foto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Remove Metadata” strips the location, phone model, and date before you share a photo."
          }
        }
      }
    },
    "· funziona con migliaia di siti": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "· works with thousands of sites"
          }
        }
      }
    },
    "È disponibile OrbitLR %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OrbitLR %@ Is Available"
          }
        }
      }
    },
    "È il peso previsto del risultato, prima di scegliere: verde se il file diventa più leggero, color ottone se diventa più pesante. Compare solo dove la stima è affidabile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s the estimated size of the result, before you choose: green if the file gets smaller, brass if it gets larger. It only appears where the estimate is reliable."
          }
        }
      }
    },
    "È uscita OrbitLR %@: un clic la scarica e la installa, e OrbitLR si riapre da sola": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OrbitLR %@ is out: one click downloads and installs it, and OrbitLR reopens on its own"
          }
        }
      }
    },
